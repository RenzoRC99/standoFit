{
  "info": {
    "name": "StandoFit API - Full Workout & Session Flow",
    "description": "Complete flow: plan a routine then execute a session from it",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "exerciseId1", "value": "" },
    { "key": "exerciseId2", "value": "" },
    { "key": "exerciseId3", "value": "" },
    { "key": "workoutId", "value": "" },
    { "key": "dayId", "value": "" },
    { "key": "sessionId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Planning - Create Exercises",
      "item": [
        {
          "name": "Create Bench Press",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('exerciseId1', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bench Press\",\n  \"description\": \"Barbell bench press\",\n  \"muscleGroup\": \"CHEST\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/exercises", "host": ["{{baseUrl}}"], "path": ["api", "exercises"] }
          }
        },
        {
          "name": "Create Squat",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('exerciseId2', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Squat\",\n  \"description\": \"Barbell back squat\",\n  \"muscleGroup\": \"LEGS\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/exercises", "host": ["{{baseUrl}}"], "path": ["api", "exercises"] }
          }
        },
        {
          "name": "Create Pull Up",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('exerciseId3', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pull Up\",\n  \"description\": \"Wide grip pull up\",\n  \"muscleGroup\": \"BACK\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/exercises", "host": ["{{baseUrl}}"], "path": ["api", "exercises"] }
          }
        }
      ]
    },
    {
      "name": "2. Planning - Create Workout Routine",
      "item": [
        {
          "name": "Save First Day ID (pre-requisite)",
          "description": "Fetch the default full body workout from seed data and extract the first day ID. Runs automatically before 'Start Session'.",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('dayId')) {",
                  "  pm.sendRequest('{{baseUrl}}/api/workouts/00000000-0000-0000-0000-000000000001', function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "      var json = res.json();",
                  "      if (json.days && json.days.length > 0) {",
                  "        pm.collectionVariables.set('dayId', json.days[0].id);",
                  "      }",
                  "    }",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/workouts/00000000-0000-0000-0000-000000000001", "host": ["{{baseUrl}}"], "path": ["api", "workouts", "00000000-0000-0000-0000-000000000001"] }
          }
        },
        {
          "name": "Create Upper/Lower Split",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('workoutId', json.id);",
                  "if (json.days && json.days.length > 0) {",
                  "  pm.collectionVariables.set('dayId', json.days[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Upper/Lower Split\",\n  \"description\": \"4-day upper/lower split routine\",\n  \"days\": [\n    {\n      \"name\": \"Upper Body\",\n      \"exercises\": [\n        { \"exerciseId\": \"{{exerciseId1}}\", \"sets\": 4, \"reps\": 10, \"restSeconds\": 90 },\n        { \"exerciseId\": \"{{exerciseId3}}\", \"sets\": 3, \"reps\": 12, \"restSeconds\": 60 }\n      ]\n    },\n    {\n      \"name\": \"Lower Body\",\n      \"exercises\": [\n        { \"exerciseId\": \"{{exerciseId2}}\", \"sets\": 5, \"reps\": 8, \"restSeconds\": 120 }\n      ]\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/workouts", "host": ["{{baseUrl}}"], "path": ["api", "workouts"] }
          }
        },
        {
          "name": "Get Workout by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/workouts/{{workoutId}}", "host": ["{{baseUrl}}"], "path": ["api", "workouts", "{{workoutId}}"] }
          }
        }
      ]
    },
    {
      "name": "3. Execution - Start & Complete Session",
      "item": [
        {
          "name": "Start Session",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('dayId')) {",
                  "  pm.sendRequest('{{baseUrl}}/api/workouts/00000000-0000-0000-0000-000000000001', function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "      var json = res.json();",
                  "      if (json.days && json.days.length > 0) {",
                  "        pm.collectionVariables.set('dayId', json.days[0].id);",
                  "      }",
                  "    }",
                  "  });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var body = pm.response.text();",
                  "pm.collectionVariables.set('sessionId', body.replace(/\"/g, ''));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dayId\": \"{{dayId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/sessions", "host": ["{{baseUrl}}"], "path": ["api", "sessions"] }
          }
        },
        {
          "name": "Get Session by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/sessions/{{sessionId}}", "host": ["{{baseUrl}}"], "path": ["api", "sessions", "{{sessionId}}"] }
          }
        },
        {
          "name": "Add Exercise Log",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exerciseId\": \"{{exerciseId1}}\",\n  \"sets\": 4,\n  \"reps\": 10,\n  \"weight\": 60\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/logs", "host": ["{{baseUrl}}"], "path": ["api", "sessions", "{{sessionId}}", "logs"] }
          }
        },
        {
          "name": "Update Session Notes",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Great session! Increased weight by 5kg.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/notes", "host": ["{{baseUrl}}"], "path": ["api", "sessions", "{{sessionId}}", "notes"] }
          }
        },
        {
          "name": "Finish Session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/finish", "host": ["{{baseUrl}}"], "path": ["api", "sessions", "{{sessionId}}", "finish"] }
          }
        },
        {
          "name": "Verify Completed Session",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/sessions/{{sessionId}}", "host": ["{{baseUrl}}"], "path": ["api", "sessions", "{{sessionId}}"] }
          }
        }
      ]
    }
  ]
}
