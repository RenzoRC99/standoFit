{
  "info": {
    "name": "StandoFit API",
    "description": "API de StandoFit para testing - Complete collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "workoutId",
      "value": "",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "exerciseId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Workouts",
      "item": [
        {
          "name": "Listar todos los workouts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/workouts"
          }
        },
        {
          "name": "Get workout by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/workouts/{{workoutId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workouts", "{{workoutId}}"]
            }
          }
        },
        {
          "name": "Crear workout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/workouts",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nuevo Workout\",\n  \"description\": \"Descripción del workout\",\n  \"days\": [\n    {\n      \"name\": \"Día 1 - Pecho\",\n      \"exercises\": []\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Renombrar workout",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/workouts/{{workoutId}}/name",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workouts", "{{workoutId}}", "name"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nuevo nombre\"\n}"
            }
          }
        },
        {
          "name": "Cambiar descripción",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/workouts/{{workoutId}}/description",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workouts", "{{workoutId}}", "description"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Nueva descripción\"\n}"
            }
          }
        },
        {
          "name": "Archivar workout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/workouts/{{workoutId}}/archive",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workouts", "{{workoutId}}", "archive"]
            }
          }
        },
        {
          "name": "Duplicar workout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/workouts/{{workoutId}}/duplicate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workouts", "{{workoutId}}", "duplicate"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newName\": \"Copia de Workout\"\n}"
            }
          }
        },
        {
          "name": "Añadir día al workout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/workouts/{{workoutId}}/days",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workouts", "{{workoutId}}", "days"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dayName\": \"Día 2 - Espalda\",\n  \"exercises\": [\n    {\n      \"exerciseId\": \"12345678-1234-1234-1234-123456789012\",\n      \"sets\": 3,\n      \"reps\": 10,\n      \"restSeconds\": 60\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Eliminar día del workout",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/workouts/{{workoutId}}/days/11111111-1111-1111-1111-111111111111",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workouts", "{{workoutId}}", "days", "11111111-1111-1111-1111-111111111111"]
            }
          }
        },
        {
          "name": "Reordenar días",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/workouts/{{workoutId}}/days/reorder",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workouts", "{{workoutId}}", "days", "reorder"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dayIds\": [\n    \"22222222-2222-2222-2222-222222222222\",\n    \"11111111-1111-1111-1111-111111111111\"\n  ]\n}"
            }
          }
        },
        {
          "name": "Buscar workouts",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/workouts/search",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderBy\": \"createdAt\",\n  \"order\": \"DESC\",\n  \"page\": 0,\n  \"pageSize\": 10,\n  \"filters\": [\n    {\n      \"field\": \"name\",\n      \"operator\": \"LIKE\",\n      \"value\": \"workout\"\n    },\n    {\n      \"field\": \"archived\",\n      \"operator\": \"EQUALS\",\n      \"value\": \"false\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Eliminar workout",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/workouts/{{workoutId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workouts", "{{workoutId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "Listar todas las sesiones",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/sessions"
          }
        },
        {
          "name": "Get session by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}"]
            }
          }
        },
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/sessions/start",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workoutDayId\": \"11111111-1111-1111-1111-111111111111\"\n}"
            }
          }
        },
        {
          "name": "Finalizar sesión",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/finish",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}", "finish"]
            }
          }
        },
        {
          "name": "Cancelar sesión",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}", "cancel"]
            }
          }
        },
        {
          "name": "Eliminar sesión",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}"]
            }
          }
        },
        {
          "name": "Añadir ejercicio log",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/logs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}", "logs"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exerciseId\": \"12345678-1234-1234-1234-123456789012\",\n  \"sets\": 3,\n  \"reps\": 10,\n  \"weight\": 50.5,\n  \"restSeconds\": 60\n}"
            }
          }
        },
        {
          "name": "Actualizar peso",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/logs/22222222-2222-2222-2222-222222222222/weight",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}", "logs", "22222222-2222-2222-2222-222222222222", "weight"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"weight\": 55.0\n}"
            }
          }
        },
        {
          "name": "Actualizar reps",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/logs/22222222-2222-2222-2222-222222222222/reps",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}", "logs", "22222222-2222-2222-2222-222222222222", "reps"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reps\": 12\n}"
            }
          }
        },
        {
          "name": "Actualizar sets",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/logs/22222222-2222-2222-2222-222222222222/sets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}", "logs", "22222222-2222-2222-2222-222222222222", "sets"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sets\": 4\n}"
            }
          }
        },
        {
          "name": "Eliminar exercise log",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/logs/22222222-2222-2222-2222-222222222222",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}", "logs", "22222222-2222-2222-2222-222222222222"]
            }
          }
        },
        {
          "name": "Actualizar notas",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}/notes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "sessions", "{{sessionId}}", "notes"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Buena sesión, aumentar peso la próxima vez\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Exercises",
      "item": [
        {
          "name": "Listar ejercicios",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/exercises"
          }
        },
        {
          "name": "Get ejercicio por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/exercises/{{exerciseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "exercises", "{{exerciseId}}"]
            }
          }
        },
        {
          "name": "Buscar por muscle group",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/exercises/muscle-group/CHEST",
              "host": ["{{baseUrl}}"],
              "path": ["api", "exercises", "muscle-group", "CHEST"]
            }
          }
        },
        {
          "name": "Buscar ejercicio por nombre",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/exercises/search?name=press",
              "host": ["{{baseUrl}}"],
              "path": ["api", "exercises", "search"],
              "query": [{ "key": "name", "value": "press" }]
            }
          }
        },
        {
          "name": "Crear ejercicio",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/exercises",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Press de banca\",\n  \"description\": \"Ejercicio de pecho con barra\",\n  \"muscleGroup\": \"CHEST\"\n}"
            }
          }
        },
        {
          "name": "Actualizar ejercicio",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/exercises/{{exerciseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "exercises", "{{exerciseId}}"]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Press de banca modificado\",\n  \"description\": \"Nueva descripción\",\n  \"muscleGroup\": \"CHEST\"\n}"
            }
          }
        },
        {
          "name": "Eliminar ejercicio",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/exercises/{{exerciseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "exercises", "{{exerciseId}}"]
            }
          }
        }
      ]
    }
  ]
}