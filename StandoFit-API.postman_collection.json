          "name": "1. Start Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var body = pm.response.text();",
                  "var id = body.replace(/\"/g, '');",
                  "pm.collectionVariables.set('sessionId', id);"
